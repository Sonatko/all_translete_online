-    @staticmethod
-    def _is_pos_visible(x, y, margin=50):
-        for screen in QApplication.screens():
-            geo = screen.availableGeometry()
-            if geo.left() <= x + margin and x < geo.right() and geo.top() <= y + margin and y < geo.bottom():
-                return True
-        return False
