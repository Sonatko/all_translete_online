-                gpu_reserved_mb = torch.cuda.memory_reserved() / 1024 / 1024
-        except Exception:
-            pass
-        msgs = len(self._overlay._messages) if self._overlay else 0
-        vad_buf = len(self._vad._speech_buffer)
-        return {
-            "rss": rss_mb,
-            "worker_rss": worker_rss_mb,
-            "total_rss": rss_mb + worker_rss_mb,
