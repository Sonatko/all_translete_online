+    # Master toggle for Subtitles + Transcription (Run/Stop)
+    def _on_master_sub_run_toggle():
+        sub_visible = subwin_toggle_action.isChecked()
+        running = _is_running[0]
+        if sub_visible or running:
+            # Turn both OFF: Hide subtitles and Pause transcription
+            subwin_toggle_action.setChecked(False)
