# Environment variables & secrets
.env
*.local
*.secret

# Tool configurations containing private API keys
configs/**/setting.json
configs/**/config.json
!configs/**/*.template.json

# Cache and temporary logs
*.log
*.tmp
scratch/
.cache/
__pycache__/
.venv/
# Heavy weights and binary models (pulled by SETUP_ECOSYSTEM.bat)
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.zip
*.tar.gz
# Third-party upstream applications (downloaded and patched by SETUP_ECOSYSTEM.bat)
stage_1_audio/LiveTranslate/
!stage_1_audio/LiveTranslate/asr_sherpa.py
!stage_1_audio/LiveTranslate/vad_sherpa.py
stage_1_audio/nllb_server/models/
stage_2_screen/OverTranslate/current/
bin/
*.exe
*.msi
.trash_anki/
archive/
dist/
all_translete_online_release.zip

# Explicitly track CONFIG directory
!CONFIG/
!CONFIG/**
