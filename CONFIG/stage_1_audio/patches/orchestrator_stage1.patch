-    @staticmethod
-    def _get_segmenter(lang: str):
-        from yasbd import get_supported_langs, pysbd_adapter
-        if lang not in LiveTranslateApp._segmenter_cache:
-            seg_lang = lang if lang in get_supported_langs() else "en"
