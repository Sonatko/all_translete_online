# Environment variables & secrets
.env
*.local
*.secret

# Tool configurations containing private API keys
configs/**/setting.json
configs/**/config.json
!configs/**/*.template.json

# Cache and temporary logs
*.log
*.tmp
scratch/
.cache/
__pycache__/
.venv/
# Heavy weights and binary models (pulled by SETUP_ECOSYSTEM.bat)
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.zip
*.tar.gz
# LiveTranslate working directory (100% orchestrated out-of-tree via CONFIG/)
stage_1_audio/LiveTranslate/
stage_1_audio/nllb_server/models/
release/
stage_1_audio/nllb_server/backends/
stage_3_voice/models/
stage_3_voice/scratch/
stage_2_screen/OverTranslate/current/
stage_2_screen/OverTranslate/*.dll
stage_2_screen/OverTranslate/*.json
hub_*_preview.png
bin/
*.exe
*.msi
.trash_anki/
archive/
dist/
all_translete_online_release.zip

# Explicitly track CONFIG directory
!CONFIG/
!CONFIG/**

# Exclude bytecode caches even inside tracked CONFIG
CONFIG/**/__pycache__/
CONFIG/**/*.py[cod]
**/__pycache__/
*.py[cod]

.idea/
