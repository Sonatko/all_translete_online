{
  "name": "Speed_Gaming",
  "version": 2,
  "incoming": {
    "enabled": true,
    "source_lang": "en",
    "target_lang": "ru",
    "speak": true,
    "show_subtitles": true,
    "skip_same_language": true,
    "output_device": "",
    "volume": 1.0,
    "voice_speed": 1.0,
    "voice_pitch": 0.0,
    "passthrough": false,
    "passthrough_volume": 1.0,
    "duck_passthrough": 0.25,
    "hear_originals": false
  },
  "outgoing": {
    "enabled": true,
    "source_lang": "ru",
    "target_lang": "en",
    "follow_their_language": false,
    "speak": true,
    "output_device": "Playback 1/2",
    "volume": 1.0,
    "voice_speed": 1.0,
    "voice_pitch": 0.0,
    "passthrough": true,
    "passthrough_volume": 1.0,
    "monitor_device": "",
    "monitor_volume": 0.5,
    "monitor": false
  },
  "input": {
    "listen_mode": "app",
    "listen_app": "discord",
    "listen_device": "",
    "mic_device": "",
    "mic_mode": "ptt",
    "ptt_key": "f8",
    "hear_key": "f9",
    "listen_vad": {
      "auto": true,
      "threshold_db": -45.0,
      "silence_ms": 150,
      "min_speech_ms": 250,
      "max_utterance_s": 12.0,
      "pre_roll_ms": 200
    },
    "mic_vad": {
      "auto": true,
      "threshold_db": -42.0,
      "silence_ms": 120,
      "min_speech_ms": 200,
      "max_utterance_s": 15.0,
      "pre_roll_ms": 200
    },
    "pause_listen_while_speaking": true,
    "ignore_mic_while_playing": false,
    "mic_gain_db": 0.0,
    "listen_gain_db": 0.0
  },
  "stt": {
    "provider": "gigaam",
    "settings": {
      "gigaam": {
        "cpu_threads": 2
      }
    }
  },
  "translation": {
    "provider": "opus_mt",
    "settings": {
      "opus_mt": {
        "cpu_threads": 2,
        "beam_size": 1
      }
    },
    "style": "natural",
    "context_lines": 4,
    "glossary": "",
    "keep_profanity": true
  },
  "ai": {
    "provider": "openai",
    "settings": {},
    "custom_prompt": ""
  },
  "tts": {
    "provider": "kokoro",
    "settings": {
      "piper": {
        "length_scale": 0.95
      },
      "kokoro": {
        "speed": 1.05
      }
    },
    "voices": {
      "kokoro": {
        "outgoing": "am_michael"
      }
    },
    "gender": "male"
  },
  "speech": {
    "names": "short",
    "repeat_names": false,
    "catchup": true
  },
  "speakers": {
    "enabled": false,
    "client_id": ""
  },
  "chat": {
    "auto_translate": false,
    "target_lang": "ru",
    "skip_same_language": true,
    "include_embeds": true,
    "my_name": "",
    "history": 5,
    "poll_ms": 700,
    "overlay_attach": true,
    "overlay_lines": 6,
    "engine": "",
    "display": "inline",
    "hotkey_inline": "ctrl+alt+i",
    "speak": false,
    "speak_mode": "queue",
    "select_translate": true,
    "select_scope": "discord",
    "popup_seconds": 10,
    "hotkey_selection": "ctrl+alt+t",
    "hotkey_draft": "ctrl+alt+y",
    "hotkey_ocr": "ctrl+alt+o",
    "compose_lang": "auto",
    "draft_send": false,
    "ocr_lang": "auto",
    "clipboard_watch": false
  },
  "ui": {
    "subtitle_font_size": 22,
    "subtitle_opacity": 0.85,
    "subtitle_show_original": true,
    "subtitle_lines": 3,
    "subtitle_show_mine": true,
    "autosave_transcript": true,
    "autosave_settings": true
  }
}
