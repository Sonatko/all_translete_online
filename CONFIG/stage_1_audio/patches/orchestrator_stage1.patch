-                worker_rss_mb = (
-                    psutil.Process(client.pid).memory_info().rss / 1024 / 1024
-                )
-            except Exception:
-                worker_rss_mb = 0.0
-        gpu_alloc_mb = 0.0
-        gpu_reserved_mb = 0.0
-        try:
-            if torch.cuda.is_available():
